<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme (default) — modern flat palette -->
    <Color x:Key="BgColor">#FF1A1D23</Color>
    <Color x:Key="BgAltColor">#FF23262E</Color>
    <Color x:Key="SurfaceColor">#FF2B2F38</Color>
    <Color x:Key="SurfaceHoverColor">#FF343945</Color>
    <Color x:Key="BorderColor">#FF3A3F4B</Color>
    <Color x:Key="TextColor">#FFE8E9EC</Color>
    <Color x:Key="TextMutedColor">#FF9AA0AC</Color>
    <Color x:Key="AccentColor">#FF3D8BFD</Color>
    <Color x:Key="AccentHoverColor">#FF5B9DFE</Color>
    <Color x:Key="GoodColor">#FF3DDC84</Color>
    <Color x:Key="WarnColor">#FFFFC93D</Color>
    <Color x:Key="BadColor">#FFFF5C5C</Color>
    <Color x:Key="HeaderBgColor">#FF12141A</Color>
    <Color x:Key="GridLineColor">#FF33383F</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BgAltBrush" Color="{StaticResource BgAltColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}"/>

</ResourceDictionary>
