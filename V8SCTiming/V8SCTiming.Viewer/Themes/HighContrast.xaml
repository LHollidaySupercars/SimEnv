<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- High Contrast theme — pure black/white with strong, saturated
         accent/status colours for maximum legibility (WCAG AAA-oriented). -->
    <Color x:Key="BgColor">#FF000000</Color>
    <Color x:Key="BgAltColor">#FF000000</Color>
    <Color x:Key="SurfaceColor">#FF000000</Color>
    <Color x:Key="SurfaceHoverColor">#FF262626</Color>
    <Color x:Key="BorderColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">#FFFFFFFF</Color>
    <Color x:Key="TextMutedColor">#FFE0E0E0</Color>
    <Color x:Key="AccentColor">#FF00C8FF</Color>
    <Color x:Key="AccentHoverColor">#FF66E0FF</Color>
    <Color x:Key="GoodColor">#FF00FF66</Color>
    <Color x:Key="WarnColor">#FFFFFF00</Color>
    <Color x:Key="BadColor">#FFFF3333</Color>
    <Color x:Key="HeaderBgColor">#FF000000</Color>
    <Color x:Key="GridLineColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BgAltBrush" Color="{StaticResource BgAltColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}"/>

</ResourceDictionary>
