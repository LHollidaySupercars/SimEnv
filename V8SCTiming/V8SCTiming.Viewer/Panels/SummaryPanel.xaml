<UserControl x:Class="V8SCTiming.Viewer.Panels.SummaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Car" Binding="{Binding CarNumber}" Width="60"/>
                <DataGridTextColumn Header="Best" Binding="{Binding Best, StringFormat={}{0:0.000}}" Width="80"/>
                <DataGridTextColumn Header="Avg" Binding="{Binding Avg, StringFormat={}{0:0.000}}" Width="80"/>
                <DataGridTextColumn Header="Worst" Binding="{Binding Worst, StringFormat={}{0:0.000}}" Width="80"/>
                <DataGridTextColumn Header="σ" Binding="{Binding StdDev, StringFormat={}{0:0.000}}" Width="80"/>
                <DataGridTextColumn Header="Laps" Binding="{Binding Count}" Width="60"/>
                <DataGridTextColumn Header="Best S1" Binding="{Binding BestS1, StringFormat={}{0:0.000}}" Width="80"/>
                <DataGridTextColumn Header="Best S2" Binding="{Binding BestS2, StringFormat={}{0:0.000}}" Width="80"/>
                <DataGridTextColumn Header="Best S3" Binding="{Binding BestS3, StringFormat={}{0:0.000}}" Width="80"/>
                <DataGridTextColumn Header="Top Speed" Binding="{Binding TopSpeed}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
