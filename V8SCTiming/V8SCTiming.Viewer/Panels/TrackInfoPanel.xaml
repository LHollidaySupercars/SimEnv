<UserControl x:Class="V8SCTiming.Viewer.Panels.TrackInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBlock x:Name="Body" Margin="20" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                   Text="Track/event info is populated from the live Supercars feed's track-info message. Live session-event tailing (as opposed to lap tailing) is a follow-up item — see README.md."/>
    </Grid>
</UserControl>
